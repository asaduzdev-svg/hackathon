# --- Server ---
PORT=5000
NODE_ENV=production

# --- Database (PostgreSQL) ---
# Vercel + Neon yoki Supabase dan olingan connection string.
# Prisma uchun URL'da sslmode=require kerak (Neon uchun).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- JWT ---
JWT_ACCESS_SECRET=kamida-32-belgili-maxfiy-kalit
JWT_REFRESH_SECRET=boshqa-maxfiy-kalit-32-beldan-uzoq
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Cookies ---
# Production muhitda secure=true, sameSite=none bo'lishi kerak.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=

# --- CORS / Frontend ---
# Frontend domeni (Vercel URL yoki localhost).
FRONTEND_URL=https://your-frontend.vercel.app

# --- Telegram bot (ixtiyoriy) ---
# Long-running bot Vercel serverless'da ishlamaydi, faqat local/Render uchun.
BOT_TOKEN=

# --- AI (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
